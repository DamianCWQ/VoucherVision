# VoucherVision Environment Variables Configuration
# Copy this file to .env and customize as needed

# ===================================================================
# OLLAMA CONFIGURATION
# ===================================================================
# Base URL for your Ollama instance
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=0

# Custom model name when using "Ollama Custom" option
# Example: llama3.2, mistral, your-custom-model
# llama3.1:8b-instruct-q4_K_S
OLLAMA_CUSTOM_MODEL_NAME=

# ===================================================================
# API KEYS (existing configuration)
# ===================================================================
# OpenAI API Key
# OPENAI_API_KEY=your-openai-api-key-here

# Azure OpenAI Configuration
# AZURE_API_KEY=your-azure-api-key-here
# AZURE_API_VERSION=your-api-version
# AZURE_API_BASE=your-azure-endpoint
# AZURE_ORGANIZATION=your-organization
# AZURE_DEPLOYMENT_NAME=your-deployment-name

# Google Cloud Configuration
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json
# GOOGLE_API_KEY=your-google-api-key

# Mistral AI API Key
# MISTRAL_API_KEY=your-mistral-api-key-here

# Hyperbolic API Key
# HYPERBOLIC_API_KEY=your-hyperbolic-api-key-here

# Hugging Face Token
# HUGGING_FACE_KEY=your-huggingface-token-here

# ===================================================================
# CUSTOM MODEL PROVIDERS (examples)
# ===================================================================
# You can add custom environment variables for other providers here
# Example for a custom API endpoint:
# CUSTOM_LLM_API_URL=http://your-custom-endpoint:8000
# CUSTOM_LLM_API_KEY=your-custom-api-key
